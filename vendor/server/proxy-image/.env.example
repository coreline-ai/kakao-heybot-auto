# Internal listener
IMAGE_PROXY_HOST=127.0.0.1
IMAGE_PROXY_PORT=4347

# manager 호출 검증용 credential의 이 패키지 로컬 복사본
IMAGE_PROXY_MANAGER_SECRET_FILE=./runtime/secrets/manager.secret

# Internal proxy-codex upstream
IMAGE_PROXY_CODEX_BASE_URL=http://127.0.0.1:4348
IMAGE_PROXY_CODEX_SERVICE_ID=image
IMAGE_PROXY_CODEX_SECRET_FILE=./runtime/secrets/codex-upstream.secret
IMAGE_PROXY_CODEX_JOB_TIMEOUT_MS=600000

# Job and artifact policy
IMAGE_PROXY_QUEUE_CONCURRENCY=1
IMAGE_PROXY_QUEUE_MAX_PENDING=20
IMAGE_PROXY_QUEUE_MAX_PENDING_PER_ROOM=3
IMAGE_PROXY_QUEUE_POLICY=fifo
IMAGE_PROXY_QUEUE_WAIT_TIMEOUT_MS=3600000
IMAGE_PROXY_PROMPT_MAX_CHARS=1000
IMAGE_PROXY_REQUEST_MAX_BYTES=32768
IMAGE_PROXY_IMAGE_MAX_BYTES=12582912
IMAGE_PROXY_ARTIFACT_RETENTION_HOURS=24
IMAGE_PROXY_RUNTIME_DIR=./runtime

# Public publishing remains disabled for the direct Iris attachment path.
IMAGE_PROXY_PUBLIC_PUBLISH_ENABLED=false
