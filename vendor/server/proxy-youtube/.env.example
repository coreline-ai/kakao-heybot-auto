YOUTUBE_PROXY_HOST=127.0.0.1
YOUTUBE_PROXY_PORT=4364
YOUTUBE_PROXY_MANAGER_SECRET_FILE=./runtime/secrets/manager.secret
YOUTUBE_PROXY_RUNTIME_DIR=./runtime
YOUTUBE_PROXY_YTDLP_BIN=/usr/local/bin/yt-dlp
YOUTUBE_PROXY_FFPROBE_BIN=/usr/local/bin/ffprobe
YOUTUBE_PROXY_FFMPEG_BIN=/usr/local/bin/ffmpeg
YOUTUBE_PROXY_RUNNER_MODE=cli
# Kakao-lite profile: 18 MiB target, 20 MiB hard artifact limit.
YOUTUBE_PROXY_MAX_BYTES=20971520
YOUTUBE_PROXY_KAKAO_TARGET_BYTES=18874368
YOUTUBE_PROXY_MAX_DURATION_SECONDS=900
YOUTUBE_PROXY_PROCESS_TIMEOUT_MS=600000
YOUTUBE_PROXY_MAX_CONCURRENCY=1
YOUTUBE_PROXY_MAX_PENDING_PER_ROOM=1
YOUTUBE_PROXY_ARTIFACT_TTL_MS=1800000
