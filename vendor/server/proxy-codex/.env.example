# Internal listener; PD20에는 노출하지 않는다.
CODEX_PROXY_HOST=127.0.0.1
CODEX_PROXY_PORT=4348
CODEX_PROXY_MANAGER_SECRET_FILE=./runtime/secrets/manager.secret
CODEX_PROXY_CALLER_SECRETS_DIR=./runtime/secrets/callers
CODEX_PROXY_CAPABILITIES_FILE=./config/capabilities.json

# Codex CLI
CODEX_CLI_BIN=codex
CODEX_HOME=
CODEX_IMAGE_MODEL=

# Global execution policy
CODEX_PROXY_QUEUE_CONCURRENCY=1
CODEX_PROXY_QUEUE_MAX_PENDING=8
CODEX_PROXY_QUEUE_WAIT_TIMEOUT_MS=600000
CODEX_PROXY_JOB_TIMEOUT_MS=360000
CODEX_PROXY_REQUEST_MAX_BYTES=32768
CODEX_PROXY_ARTIFACT_MAX_BYTES=12582912
CODEX_PROXY_ARTIFACT_RETENTION_HOURS=1
CODEX_PROXY_RUNTIME_DIR=./runtime
CODEX_PROXY_RUNNER=codex
