# Public-to-PD20 manager listener
MANAGER_HOST=127.0.0.1
MANAGER_PORT=4340

# Secret 값이 아닌 Mac 로컬 파일 경로만 설정한다.
MANAGER_ROUTE_SECRET_FILE=./runtime/secrets/route.secret
MANAGER_ADMIN_SECRET_FILE=./runtime/secrets/admin.secret

MANAGER_PROXY_REGISTRY_FILE=./config/proxies.json
MANAGER_REQUEST_MAX_BYTES=32768
MANAGER_CONNECT_TIMEOUT_MS=3000
MANAGER_UPSTREAM_CONTROL_TIMEOUT_MS=15000
MANAGER_STREAM_IDLE_TIMEOUT_MS=120000
MANAGER_HEALTH_TIMEOUT_MS=3000

# launchd 수명주기 API는 검증 전까지 비활성화한다.
MANAGER_LIFECYCLE_ENABLED=false
MANAGER_LIFECYCLE_DRIVER=launchd
