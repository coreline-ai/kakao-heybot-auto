# Default-off. Only proxy-video may call this loopback listener.
GROK_PROXY_ENABLED=false
GROK_PROXY_HOST=127.0.0.1
GROK_PROXY_PORT=4358
GROK_PROXY_VIDEO_SERVICE_ID=video
GROK_PROXY_VIDEO_SECRET_FILE=./runtime/secrets/video-upstream.secret

# These must be absolute paths for the dedicated, manually logged-in Grok CLI profile.
GROK_PROXY_CLI_COMMAND=/absolute/path/to/grok
GROK_PROXY_CLI_HOME=/absolute/path/to/cli-home
GROK_PROXY_SESSION_ROOT=/absolute/path/to/cli-home/.grok/sessions
GROK_PROXY_RUNTIME_DIR=./runtime
GROK_PROXY_PROMPT_MAX_CHARS=1000
GROK_PROXY_REQUEST_MAX_BYTES=32768
GROK_PROXY_ARTIFACT_MAX_BYTES=52428800
GROK_PROXY_JOB_TIMEOUT_MS=1800000
GROK_PROXY_QUEUE_MAX_PENDING=2
GROK_PROXY_ARTIFACT_RETENTION_HOURS=24
