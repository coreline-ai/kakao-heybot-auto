# Future internal listener; PD20에는 노출하지 않는다.
GROK_PROXY_ENABLED=false
GROK_PROXY_HOST=127.0.0.1
GROK_PROXY_PORT=4358
GROK_PROXY_MANAGER_SECRET_FILE=./runtime/secrets/manager.secret
GROK_PROXY_CALLER_SECRETS_DIR=./runtime/secrets/callers
GROK_PROXY_CAPABILITIES_FILE=./config/capabilities.json

# 실제 설치·명령은 doctor 검증 후 확정한다.
GROK_CLI_BIN=grok
GROK_HOME=
GROK_VIDEO_MODEL=

GROK_PROXY_QUEUE_CONCURRENCY=1
GROK_PROXY_QUEUE_MAX_PENDING=4
GROK_PROXY_QUEUE_WAIT_TIMEOUT_MS=1800000
GROK_PROXY_JOB_TIMEOUT_MS=1800000
GROK_PROXY_REQUEST_MAX_BYTES=32768
GROK_PROXY_ARTIFACT_MAX_BYTES=536870912
GROK_PROXY_ARTIFACT_RETENTION_HOURS=2
